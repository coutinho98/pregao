# Postgres. Em produção (Neon): DATABASE_URL = conexão pooled, DIRECT_URL = conexão direta (migrations).
DATABASE_URL=postgresql://pregao:pregao@localhost:5440/pregao
DIRECT_URL=postgresql://pregao:pregao@localhost:5440/pregao
# Banco usado pelos testes de integração (é limpo a cada execução).
TEST_DATABASE_URL=postgresql://pregao:pregao@localhost:5440/pregao_test

PORT=3000
# Origens do front liberadas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Gere com: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
